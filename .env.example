# Copy to .env and edit. The start script loads this file if present.
# .env is gitignored; .env.example is not — keep real credentials out of it.

# Where Label Studio keeps its SQLite DB, uploads and exports.
LABEL_STUDIO_BASE_DATA_DIR=.label-studio

# Bind address / port for the local server.
LABEL_STUDIO_HOST=http://localhost:8080
LABEL_STUDIO_PORT=8080

# Bootstrap account. Created on first run only; ignored afterwards.
LABEL_STUDIO_USERNAME=you@example.com
LABEL_STUDIO_PASSWORD=change-me-please

# Skip the "share anonymous usage data" prompt on first launch.
COLLECT_ANALYTICS=false

# Set to a long random string if you expose this beyond localhost.
# DJANGO_SECRET_KEY=
